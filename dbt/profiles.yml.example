# Copy this to ~/.dbt/profiles.yml (dbt's default profile location).
# Do not commit a filled-in version of this file - credentials are read
# from environment variables (same names as .env) via env_var(), never
# hardcoded here.

sales_db:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE') }}"
      database: SALES_DB
      schema: STAGING
      threads: 4
